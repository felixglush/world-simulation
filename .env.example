# Supply the real key through Codex Cloud secrets; this file contains no credentials.
OPENROUTER_API_KEY=
# TypeSafe SDK base URL: the SDK appends /v1/systemone.
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13
# Captain SDK base URL: the SDK appends /chat/completions.
CAPTAIN_BASE_URL=https://openrouter.ai/api/v1
# Choose an OpenRouter model with tool calling for live captain runs.
CAPTAIN_MODEL=
# Consumed by the CLI provider adapters; .env is not automatically loaded.
