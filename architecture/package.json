{
  "name": "station-control-architecture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "node scripts/check-model.ts",
    "test": "playwright test",
    "format": "prettier --write src/*.{ts,tsx,css} src/model.json scripts/*.ts tests/*.ts *.ts *.html *.md",
    "format:check": "prettier --check src/*.{ts,tsx,css} src/model.json scripts/*.ts tests/*.ts *.ts *.html *.md"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
